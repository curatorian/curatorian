<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Keluar · Curatorian</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-base-200">
    <div class="flex min-h-screen items-center justify-center p-6">
      <div class="card bg-base-100 shadow-xl border border-base-300 w-full max-w-sm">
        <div class="card-body items-center text-center gap-4">
          <div class="w-14 h-14 rounded-full bg-primary/15 flex items-center justify-center">
            <.icon name="hero-arrow-right-on-rectangle" class="size-7 text-primary" />
          </div>
          <h1 class="text-lg font-semibold">Keluar dari Curatorian</h1>
          <p class="text-sm text-base-content/60">
            Menyelesaikan proses keluar…
          </p>

          <.form
            for={%{}}
            action={~p"/logout"}
            method="delete"
            id="logout-confirm-form"
            class="hidden"
          >
            <button type="submit">Keluar</button>
          </.form>

          <button
            type="button"
            onclick="document.getElementById('logout-confirm-form').submit()"
            class="btn btn-primary w-full"
          >
            Konfirmasi keluar
          </button>
        </div>
      </div>
    </div>

    <script nonce={@script_nonce}>
      window.addEventListener("DOMContentLoaded", () => {
        document.getElementById("logout-confirm-form").submit();
      });
    </script>
  </body>
</html>
