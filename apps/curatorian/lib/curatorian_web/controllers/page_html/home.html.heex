<Layouts.app flash={@flash} current_scope={@current_scope} current_uri={@conn.request_path}>
  <section class="">
    <div class="relative w-full h-full max-h-screen">
      <img src="/images/lib.webp" alt="hero img" class="w-full h-screen object-cover" />
      <div class="absolute top-0 bg-black/80 w-full h-screen"></div>
    </div>

    <div class="absolute w-full min-h-screen inset-0 flex items-center max-w-7xl mx-auto">
      <div class="flex flex-col w-full text-white items-center justify-center">
        <h1 class="homepage-heading">Curatorian</h1>

        <h6 class="text-sm md:text-base lg:text-lg italic text-center">
          Curating connections, collections, and cognitions
        </h6>

        <%!-- Flagship cross-node collection search --%>
        <div class="w-full max-w-2xl mx-auto mt-8">
          <.search_bar id="hero-search" variant={:hero} with_quick_filters />
        </div>

        <%!-- Auth CTAs (compact, beneath the search) --%>
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mt-8">
          <a
            href="/guides"
            class="inline-flex items-center gap-2 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/60 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200"
          >
            <.icon name="hero-book-open" class="size-4" /> Panduan
          </a>
          <a
            href="/register"
            class="inline-flex items-center gap-2 rounded-xl bg-violet-600 hover:bg-violet-700 px-6 py-2.5 text-sm font-semibold text-white shadow-lg transition-all duration-200"
          >
            Daftar Gratis <.icon name="hero-arrow-right" class="size-4" />
          </a>
          <a
            href="/roadmap"
            class="inline-flex items-center gap-2 rounded-xl bg-violet-600 hover:bg-violet-700 border border-violet-300/60 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200"
          >
            Roadmap
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 w-full h-24 bg-gradient-to-t from-base-100 dark:from-base-600 to-transparent">
    </div>
  </section>

  <section>
    <.apa_itu_curatorian /> <.kenapa_harus_curatorian /> <.cara_kerja_curatorian />
  </section>

  <section>
    <.fitur_utama_curatorian current_scope={@current_scope} /> <.tertarik_dengan_curatorian />
  </section>
</Layouts.app>
