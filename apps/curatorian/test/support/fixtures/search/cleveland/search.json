 [], "date": "1988\u2013", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "The fiercest looking Kala masks are from eastern Java, made between the 10th to 15th century.", "early_education_description": null, "artlens_description": null, "description": "The bulging eyes and curved fangs of Kala emphasize the ferocity of the figure who stands for Time and Death, the devourer of all creation. Placed above the entry to an Indonesian temple, Kala serves both to protect the site and indicate a symbolic rebirth for those who pass beneath to enter the sacred space. Though related to the faces of glory on monuments in India, Kala and the volcanic stone from which it has been carved are distinctively Javanese.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79928011"], "internet_archive": ["https://archive.org/details/clevelandart-1975.104-architectural-sculpt"]}, "citations": [{"citation": "Lee, Sherman E. \u201cThe Year in Review for 1975.\u201d <em>The Bulletin of the Cleveland Museum of Art</em> 63, no. 2 (February 1976): 31\u201371.", "page_number": "Mentioned: p. 71, no. 168", "url": "https://www.jstor.org/stable/25152624"}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1978</em>. Cleveland, OH: The Cleveland Museum of Art, 1978.", "page_number": "Reproduced: p. 321", "url": "https://archive.org/details/CMAHandbook1978/page/n341"}], "url": "https://clevelandart.org/art/1975.104", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_web.jpg", "width": "900", "height": "696", "filesize": "330966", "filename": "1975.104_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_print.jpg", "width": "3400", "height": "2629", "filesize": "2730634", "filename": "1975.104_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_full.tif", "width": "5461", "height": "4223", "filesize": "69225152", "filename": "1975.104_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt0_web.jpg", "width": "900", "height": "663", "filesize": "246815"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt0_print.jpg", "width": "3400", "height": "2506", "filesize": "1932872"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt0_full.tif", "width": "6668", "height": "4914", "filesize": "98333904"}, "date_created": "2012-07-10T14:13:28", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt1_web.jpg", "width": "1091", "height": "893", "filesize": "256709"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt1_print.jpg", "width": "3400", "height": "2782", "filesize": "2079986"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1975.104/1975.104_alt1_full.tif", "width": "5403", "height": "4421", "filesize": "71702240"}, "date_created": "2012-07-10T14:22:52", "annotation": ""}], "creditline": "Norman O. Stone and Ella A. Stone Memorial Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "models": null, "gallery_donor_text": "Nancy F. & Joseph P. Keithley Gallery", "athena_id": 148070, "creators": [], "legal_status": "accessioned", "accession_date": "1975-11-29T00:00:00", "sortable_date": 1100, "date_added_to_oa": null, "date_text": "1100s\u20131300s", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Bracket with Kala Mask"], "is_highlight": false, "updated_at": "2026-11-20 16:33:33.675000"}, {"id": 151996, "accession_number": "1984.50", "share_license_status": "CC0", "tombstone": "Tampan Pasisir (Ship Cloth), 1800s. Indonesia, Sumatra, Lampung, 19th century. Tabby weave with supplementary weft; cotton; overall: 72.4 x 66.7 cm (28 1/2 x 26 1/4 in.). The Cleveland Museum of Art, Gift of The Textile Arts Club, 1984.50", "current_location": null, "title": "Tampan Pasisir (Ship Cloth)", "creation_date": "1800s", "creation_date_earliest": 1800, "creation_date_latest": 1899, "artists_tags": [], "culture": ["Indonesia, Sumatra, Lampung, 19th century"], "technique": "tabby weave with supplementary weft; cotton", "support_materials": [], "department": "Textiles", "collection": "Textiles", "type": "Textile", "measurements": "Overall: 72.4 x 66.7 cm (28 1/2 x 26 1/4 in.)", "dimensions": {"overall": {"height": 0.724, "height_inch": 28, "height_inch_fraction": 0.5, "width": 0.667, "width_inch": 26, "width_inch_fraction": 0.25}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 309852, "title": "Material Matters: Fifty Years of Gifts from the Textile Arts Club", "description": "<i>Material Matters: Fifty Years of Gifts from the Textile Arts Club</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 21-December 30, 1984).", "opening_date": "1984-11-21T05:00:00"}, {"id": 309849, "title": "Year in Review for 1984", "description": "<i>Year in Review for 1984</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (April 3-May 5, 1985).", "opening_date": "1985-04-03T05:00:00"}, {"id": 311444, "title": "Object Lessons: Cleveland Creates an Art Museum", "description": "<i>Object Lessons: Cleveland Creates an Art Museum</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 7-September 8, 1991).", "opening_date": "1991-06-07T04:00:00"}], "legacy": []}, "provenance": [], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": null, "early_education_description": null, "artlens_description": null, "description": "For several hundred years, until early in the present century, textiles of this type played an essential, symbolic role in virtually every southern Sumatran ritual. Since there is no written mythological literature in Indonesia, the exact meaning of the \"tampan pasisir\" (as this ritual cloth is called) remains unknown. Nevertheless, this fine weaving must be a kind of narrative. Ships, of course, were essential to the life of these island people, and using one as an image for safe passage from one of life's stages to another seems plausible. This rare piece--few textiles of its age and condition from the tropical climes of Indonesia survive--was a most welcome gift to The Cleveland Museum of Art from the Textile Arts Club in honor of its 50th anniversary.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79936017"], "internet_archive": ["https://archive.org/details/clevelandart-1984.50-tampan-pasisir-ship"]}, "citations": [{"citation": "Wardwell, Anne E. Material Matters: Fifty Years of Gifts from the Textile Arts Club, 1934-1984 : [Exhibition] 21 November-30 December 1984, the Cleveland Museum of Art. Cleveland: The Museum, 1984.", "page_number": "p. 39; illustrated on cover", "url": null}], "url": "https://clevelandart.org/art/1984.50", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1984.50/1984.50_web.jpg", "width": "820", "height": "900", "filesize": "510838", "filename": "1984.50_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1984.50/1984.50_print.jpg", "width": "3099", "height": "3400", "filesize": "5805317", "filename": "1984.50_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1984.50/1984.50_full.tif", "width": "9129", "height": "10017", "filesize": "274369388", "filename": "1984.50_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1984.50/1984.50_alt0_web.jpg", "width": "816", "height": "900", "filesize": "524882"}, "print": {"url": "https://ope